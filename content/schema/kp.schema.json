{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kwiziq-local/content/schema/kp.schema.json",
  "title": "Knowledge Point",
  "description": "一个可独立测试的法语知识点，含微课、题目与来源标注。",
  "type": "object",
  "required": ["id", "level", "category", "title_zh", "primer", "items", "sources", "meta"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^fr\\.[a0-2][a-z0-9]*\\.[a-z0-9_]+\\.[a-z0-9_]+$",
      "description": "形如 fr.a1.negation.ne_pas；第三段为范畴，第四段为规则。"
    },
    "level": {
      "type": "string",
      "enum": ["A0", "A1", "A2L", "A2U", "B1", "B2", "C1"]
    },
    "category": {
      "type": "string",
      "enum": [
        "articles", "nouns", "adjectives", "adverbs", "pronouns",
        "verbs_tense", "verbs_mood", "prepositions", "negation",
        "questions", "comparison", "sentence_structure", "expressions", "vocabulary"
      ]
    },
    "title_zh": { "type": "string", "minLength": 2, "maxLength": 60 },
    "title_fr": { "type": "string" },
    "weight": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 2.0,
      "default": 1.0,
      "description": "该知识点对级别能力的代表性权重。"
    },
    "difficulty": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "先验难度，后续由作答数据校准。"
    },
    "prereqs": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "先修知识点 id；不得指向自身。"
    },
    "contrasts": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "易混知识点 id，用于生成辨析题。"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "reviewed", "published"],
      "default": "draft"
    },
    "primer": {
      "type": "object",
      "required": ["rule_zh", "examples", "pitfall_zh"],
      "additionalProperties": false,
      "properties": {
        "rule_zh": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120,
          "description": "一句话规则，超过 120 字说明拆得不够细。"
        },
        "examples": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["fr", "zh"],
            "additionalProperties": false,
            "properties": {
              "fr": { "type": "string", "minLength": 3 },
              "zh": { "type": "string", "minLength": 1 },
              "note_zh": { "type": "string" },
              "audio": { "type": "string" }
            }
          }
        },
        "pitfall_zh": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120,
          "description": "中文母语者最常犯的错误。"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 6,
      "maxItems": 12,
      "description": "建议 8 题：guided 3 + check 3 + kwiz 2。",
      "items": {
        "type": "object",
        "required": ["id", "type", "stage", "prompt", "answer", "explain_zh", "difficulty"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^itm\\.[a-z0-9_.]+$" },
          "type": {
            "type": "string",
            "enum": ["choice", "fill", "multi_fill", "correct", "order", "dictation", "translate"]
          },
          "stage": {
            "type": "string",
            "enum": ["guided", "check", "kwiz"]
          },
          "prompt": { "type": "string", "minLength": 3 },
          "answer": { "type": "string", "minLength": 1 },
          "accept": {
            "type": "array",
            "items": { "type": "string" },
            "description": "其他可接受答案（大小写与首尾空格由引擎统一处理）。"
          },
          "options": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "maxItems": 5,
            "description": "仅 choice 类型使用；必须包含 answer。"
          },
          "hint_zh": { "type": "string", "description": "仅 guided 阶段使用。" },
          "explain_zh": { "type": "string", "minLength": 5 },
          "difficulty": { "type": "number", "minimum": 1, "maximum": 5 },
          "audio": { "type": "string" },
          "source_ref": { "type": "string", "description": "如 tatoeba:sentence:12169789" }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "choice" } }, "required": ["type"] },
            "then": { "required": ["options"] }
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "usage"],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string", "description": "必须存在于 content/sources.json。" },
          "ref": { "type": "string", "description": "具体条目，如 sentence:12169789。" },
          "usage": {
            "type": "string",
            "enum": ["example_sentences", "grammar_taxonomy", "conjugation_generation", "tts_audio", "verification", "native_audio"]
          },
          "note": { "type": "string" }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["author", "created_at", "version"],
      "additionalProperties": false,
      "properties": {
        "author": { "type": "string" },
        "created_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reviewed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reviewer": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
